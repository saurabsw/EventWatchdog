  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Open Incidents (TSDB Metric)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "watchdog_incidents_active{state=\"OPEN\"} or 0",
          "legendFormat": "Open Incidents"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Acknowledged Incidents",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "watchdog_incidents_active{state=\"ACKNOWLEDGED\"} or 0",
          "legendFormat": "Acknowledged"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Critical Severity Active",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "sum(watchdog_incidents_active{severity=\"CRITICAL\"}) or 0",
          "legendFormat": "Critical"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Total Detections Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "sum(rate(watchdog_detections_total[5m])) * 60 or 0",
          "legendFormat": "Events / min"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 6 },
      "id": 5,
      "title": "Detection Breach Trends Over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "rate(watchdog_detections_total[1m]) * 60",
          "legendFormat": "{{metric_name}} ({{detection_type}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 6 },
      "id": 6,
      "title": "Severity Distribution",
      "type": "piechart",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "watchdog_incidents_active",
          "legendFormat": "{{severity}} - {{state}}"
        }
      ]
    }
  ],
