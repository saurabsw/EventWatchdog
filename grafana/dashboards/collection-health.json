{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Host CPU Utilization (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "100 - cpu_usage_idle or (cpu_usage_user + cpu_usage_system) or 0",
          "legendFormat": "CPU Busy %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Host Memory Used (%)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "mem_used_percent or (mem_used / mem_total * 100) or 0",
          "legendFormat": "Memory Used %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "id": 3,
      "title": "Application Log Ingestion Rate (events/min)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "rate(app_log_events_total[1m]) * 60",
          "legendFormat": "{{service}} - {{level}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "id": 4,
      "title": "Log Parse Errors (errors/min)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "rate(app_log_parse_errors_total[1m]) * 60",
          "legendFormat": "Parse Errors"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 14 },
      "id": 5,
      "title": "Observed Service Request Latency (ms)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "app_request_duration_ms",
          "legendFormat": "{{service}} (ms)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["observability", "health", "host", "logs"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Collection and Service Health",
  "uid": "collection-health",
  "version": 2
